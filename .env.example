# .env にコピーする（gitignore 済み）。実環境変数が優先されるため、CI では
# 同名の値を secrets/vars として渡す。以下の値は稼働中のホストに合わせてある。

# --- デプロイ先 ---
DEPLOY_HOST=dot.ryoha.moe
DEPLOY_GOOGLE_CLIENT_ID=894626726945-2cifbuekm9921qbk9ojntknnhkd2225f.apps.googleusercontent.com
DEPLOY_CHANNEL_IDS=[]
DEPLOY_PROJECT=workspace-401020
DEPLOY_PROJECT_NUMBER=894626726945
DEPLOY_ZONE=us-west1-c
DEPLOY_INSTANCE=discord-mcp-gce
DEPLOY_NODE_VERSION=22.23.3
# DEPLOY_CERTBOT_EMAIL=you@example.com

# --- runtime.env の上書き（必須の実値。現行ビルドは起動時にこれらを検証する） ---
DISCORD_GUILD_ID=REPLACE_ME
DISCORD_BOT_ID=REPLACE_ME
GOOGLE_ALLOWED_EMAIL=the7uya@gmail.com

# runtime.env.example のキーは同名で上書きできる。テンプレートに無いキーは
# DEPLOY_ENV_ 接頭辞で追加できる。
