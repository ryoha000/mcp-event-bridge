[Unit]
Description=Load pinned Discord MCP secrets into volatile memory
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
RemainAfterExit=yes
EnvironmentFile=/etc/discord-mcp/runtime.env
RuntimeDirectory=discord-mcp-secrets
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/node /opt/discord-mcp/scripts/fetch-gce-secrets.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0
StandardOutput=journal
StandardError=journal
