# Replace every example with your own configuration. Never put secrets here.
NODE_ENV=production
GCE_DISCORD_ENABLE=true
GCE_DISCORD_ORIGIN=https://@@HOST@@
GCE_DISCORD_SQLITE_FILE=/var/lib/discord-mcp/state.sqlite3
GCE_DISCORD_REPLIES_ENABLE=false
GOOGLE_CLIENT_ID=@@EXISTING_GOOGLE_WEB_CLIENT_ID@@
# A verified Gmail or Google Workspace owner address.
GOOGLE_ALLOWED_EMAIL=owner@example.com
PROBE_REDIRECT_URIS='["https://chatgpt.com/connector_platform_oauth_redirect"]'
# Illustrative snowflakes; replace with your guild and bot IDs.
DISCORD_GUILD_ID=100000000000000400
DISCORD_BOT_ID=100000000000001800
DISCORD_CHANNEL_SCOPE=guild-visible
# For allowlist mode, set DISCORD_CHANNEL_IDS to a JSON array of numeric channel IDs.
# Non-secret settings for the optional VM Secret Manager loader:
MCP_GCP_PROJECT=example-project
MCP_GCP_PROJECT_NUMBER=123456789012
MCP_GCP_SERVICE_ACCOUNT=discord-mcp-gce@example-project.iam.gserviceaccount.com
MCP_DISCORD_BOT_SECRET=discord-mention-bot-token
MCP_DISCORD_BOT_SECRET_VERSION=2
MCP_AUTH_SECRET=discord-consolidated-auth
MCP_AUTH_SECRET_VERSION=1
