# 各例はすべて自分の設定に置き換えること。ここにシークレットは書かないこと。
NODE_ENV=production
GCE_DISCORD_ENABLE=true
GCE_DISCORD_ORIGIN=https://@@HOST@@
GCE_DISCORD_SQLITE_FILE=/var/lib/discord-mcp/state.sqlite3
GOOGLE_CLIENT_ID=@@EXISTING_GOOGLE_WEB_CLIENT_ID@@
# 検証済みの Gmail または Google Workspace のオーナーアドレス。
GOOGLE_ALLOWED_EMAIL=owner@example.com
PROBE_REDIRECT_URIS='["https://chatgpt.com/connector_platform_oauth_redirect"]'
# 例示用のsnowflake。自分のギルドIDとbot IDに置き換えること。
DISCORD_GUILD_ID=100000000000000400
DISCORD_BOT_ID=100000000000001800
DISCORD_CHANNEL_SCOPE=guild-visible
# allowlist モードでは DISCORD_CHANNEL_IDS に数値チャンネルIDのJSON配列を設定する。

# 任意: Angelic-Angel から raw X Web Push を localhost で受け、同じ MCP Events 接続へ流す。
# X_WEB_PUSH_SOURCE_ID は秘密ではなく、監視対象を識別する安定したラベル（例: @your_handle）。
X_WEB_PUSH_ENABLE=false
X_WEB_PUSH_SOURCE_ID=@replace_me
# 任意のVM Secret Managerローダー用の非シークレット設定:
MCP_GCP_PROJECT=example-project
MCP_GCP_PROJECT_NUMBER=123456789012
MCP_GCP_SERVICE_ACCOUNT=discord-mcp-gce@example-project.iam.gserviceaccount.com
# バージョンは latest または具体的な番号。ローテーション時は latest が再読み込みで追従する。
MCP_DISCORD_BOT_SECRET=discord-mention-bot-token
MCP_DISCORD_BOT_SECRET_VERSION=latest
MCP_AUTH_SECRET=discord-consolidated-auth
MCP_AUTH_SECRET_VERSION=latest
# X Web Push を有効にする場合、監視専用 X アカウントの Cookie を Secret Manager から読む。
MCP_X_AUTH_TOKEN_SECRET=x-monitor-auth-token
MCP_X_AUTH_TOKEN_SECRET_VERSION=latest
MCP_X_CT0_SECRET=x-monitor-ct0
MCP_X_CT0_SECRET_VERSION=latest
